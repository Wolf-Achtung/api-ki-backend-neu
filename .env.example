# --- Core ---
ENV=production
APP_NAME="KI Status Report API"
LOG_LEVEL=info

# --- CORS (comma-separated) ---
CORS_ALLOW_ORIGINS="https://ki-sicherheit.jetzt,https://www.ki-sicherheit.jetzt,https://ki-foerderung.jetzt,https://make.ki-sicherheit.jetzt,https://www.make.ki-sicherheit.jetzt"

# --- Database ---
DATABASE_URL=${{Postgres.DATABASE_URL}}

# --- Auth ---
JWT_SECRET=change-me
ADMIN_EMAILS="bewertung@ki-sicherheit.jetzt"

# --- Admin Notifications (Monitoring & Alerts) ---
ADMIN_NOTIFY_EMAIL="bewertung@ki-sicherheit.jetzt"
ADMIN_FEEDBACK_EMAIL="feedback@ki-sicherheit.jetzt"

# --- SMTP ---
SMTP_HOST=smtp.udag.de
SMTP_PORT=587
SMTP_USER=bewertung@ki-sicherheit.jetzt
SMTP_PASS=***
SMTP_FROM=kontakt@ki-sicherheit.jetzt
SMTP_FROM_NAME="KI-Readiness"

# --- LLM (optimiert) ---
OPENAI_API_KEY=***
OPENAI_MODEL_DEFAULT=gpt-4o
OPENAI_TIMEOUT=120
OPENAI_MAX_TOKENS=3200
GPT_TEMPERATURE=0.2

# --- Anthropic (Executive Summary) ---
USE_ANTHROPIC_FOR_EXEC_SUMMARY=1
ANTHROPIC_API_KEY=***

# --- PDF (optimiert) ---
PDF_SERVICE_URL="https://make-ki-pdfservice-production.up.railway.app"
PDF_TIMEOUT_MS=120000
MAX_HTML_PAYLOAD_KB=350
MAX_PDF_SIZE_MB=20

# --- PDF Alert Thresholds ---
PDF_WARN_SIZE_MB=10
PDF_ALERT_SIZE_MB=18
PDF_BLOCK_SIZE_MB=20
PDF_TIMEOUT_SEC=20

# --- Research (optimiert) ---
RESEARCH_PROVIDER=hybrid
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=10
TAVILY_TIMEOUT_MS=15000
PERPLEXITY_API_KEY=
PERPLEXITY_MAX_TOKENS=2500
PERPLEXITY_TIMEOUT_MS=15000
RESEARCH_CACHE_PATH=data/research_cache.json
RESEARCH_CACHE_TTL=21600

# --- Quality & Features ---
ENABLE_QUALITY_GATES=1
ENABLE_REPAIR_HTML=1
ENABLE_LLM_CACHE=1
MASK_EMAILS=1
ENABLE_STOCK_IMAGES=0

# --- Monitoring Thresholds ---
MIN_SECTION_WORDS=50
MAX_FALLBACKS_PER_REPORT=3
GUARDRAIL_HIGH_CONF=0.9
TOKEN_BUDGET_THRESHOLD_PCT=95

# --- Sprint G8.2: Validation & AI Act Config ---
# Size mismatch handling (1=hard stop, 0=warning only)
HARD_STOP_ON_SIZE_MISMATCH=1

# Maximum redundancy warnings per report
VALIDATION_MAX_REDUNDANCY_WARNINGS=5

# Minimum words for redundancy detection
VALIDATION_REDUNDANCY_THRESHOLD=20

# AI Act Compliance Settings
AI_ACT_ENABLED=1
AI_ACT_MIN_REASONING_WORDS=60
AI_ACT_MIN_DUTY_MATRIX_ROWS=3
AI_ACT_MIN_ALERTS=2
AI_ACT_MAX_ALERTS=10
AI_ACT_MIN_GAPS=2
AI_ACT_MAX_GAPS=8
AI_ACT_SECTION_VERBOSE=0
AI_ACT_APPLY_BC_MODIFIERS=1

# Fallback hard stop
HARD_STOP_MAX_FALLBACKS=5

# --- Admin Routes (production: disabled) ---
ENABLE_ADMIN_ROUTES=0
ADMIN_ALLOW_RAW_SQL=0

# =============================================================================
# SPRINT G11: PRODUCT MODE
# =============================================================================

# --- Report Versioning ---
REPORT_VERSIONING_ENABLED=1
PDF_SNAPSHOT_ENABLED=1
MAX_STORED_REPORTS=50
MAX_REPORT_VERSIONS=10

# --- Delta Engine ---
ENABLE_DELTA_ENGINE=1
DELTA_EMBEDDING_MODEL=
DELTA_WORD_THRESHOLD=50
DELTA_SCORE_THRESHOLD=5.0

# --- Business Case Visualizer ---
ENABLE_BC_VISUALS=1

# --- Dashboard API ---
ENABLE_DASHBOARD_API=1

# --- Premium Features ---
# Smart Funding Recommender (default: disabled)
ENABLE_PREMIUM_FUNDING=0
FUNDING_DATA_PATH=data/funding_programmes_core_2025.json

# =============================================================================
# SPRINT G12: RESILIENCE & PRODUCTION SHIELD
# =============================================================================

# --- A) Circuit Breaker (LLM Providers) ---
LLM_CIRCUIT_BREAKER_ENABLED=1
LLM_CIRCUIT_FAILURE_THRESHOLD=5
LLM_CIRCUIT_RESET_SECONDS=60
LLM_CIRCUIT_WINDOW_SECONDS=90
LLM_CIRCUIT_STATE_FILE=/tmp/circuit_breaker_state.json

# --- B) Rate Limiting (Reports) ---
RATE_LIMIT_ENABLED=1
REPORT_RATE_LIMIT_PER_MINUTE=5
REPORT_RATE_LIMIT_GLOBAL=20

# --- C) Degradation Monitor ---
DEGRADATION_MONITORING_ENABLED=1
DEGRADATION_HARD_STOP_THRESHOLD=30
DEGRADATION_WARN_THRESHOLD=60
DEGRADATION_WINDOW_SECONDS=300

# --- D) AI-Act Validator v2 ---
AI_ACT_STRICT_VALIDATION=1
AI_ACT_REQUIRE_FUNDING_IMPACT=1
AI_ACT_FAIL_ON_INCONSISTENCY=0

# --- E) Business Case Reconciler ---
BC_RECONCILE_ENABLED=1
BC_ROUNDING_DECIMALS=1
BC_FAIL_ON_INCONSISTENCY=0

# --- F) PDF Guard ---
PDF_GUARD_ENABLED=1
PDF_MAX_HTML_MB=1.2
PDF_MAX_TABLES=30
PDF_MAX_IMAGES=20
PDF_MAX_LOGOS=5
PDF_FAIL_ON_OVERSIZE=0
PDF_TRUNCATE_ON_OVERSIZE=1

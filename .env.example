# --- Core ---
ENV=production
APP_NAME="KI Status Report API"
LOG_LEVEL=info

# --- CORS (comma-separated) ---
CORS_ALLOW_ORIGINS="https://ki-sicherheit.jetzt,https://www.ki-sicherheit.jetzt,https://ki-foerderung.jetzt,https://make.ki-sicherheit.jetzt,https://www.make.ki-sicherheit.jetzt"

# --- Database ---
DATABASE_URL=${{Postgres.DATABASE_URL}}

# --- Auth ---
JWT_SECRET=change-me
ADMIN_EMAILS="bewertung@ki-sicherheit.jetzt"
# Zusätzliche Test-Adressen ohne Deploy freischalten (kommagetrennt).
# Ergänzt core/whitelist.py, ersetzt sie nicht. Gibt keine Admin-Rechte.
EXTRA_WHITELIST=

# --- Cyberangriffs-Check (öffentlich, ohne Login) ---
# Eigenes Geheimnis für die Bestätigungslinks. Leer = JWT_SECRET greift.
CYBER_CONFIRM_SECRET=
# Basis für den Bestätigungslink in der Mail. Leer = Brand-app_url greift.
API_PUBLIC_URL=

# --- Service-Token (für headless/automated API-Zugriff) ---
# Aktiviert Service-Token-Auth für CI/Golden Reports
SERVICE_TOKEN_ENABLED=0
# Shared Secret für Service-Token (Format: principal:secret)
SERVICE_TOKEN_SECRET=

# --- Admin Notifications (Monitoring & Alerts) ---
ADMIN_NOTIFY_EMAIL="bewertung@ki-sicherheit.jetzt"
ADMIN_FEEDBACK_EMAIL="feedback@ki-sicherheit.jetzt"

# --- SMTP ---
SMTP_HOST=smtp.udag.de
SMTP_PORT=587
SMTP_USER=bewertung@ki-sicherheit.jetzt
SMTP_PASS=***
SMTP_FROM=kontakt@ki-sicherheit.jetzt
SMTP_FROM_NAME="KI-Readiness"

# --- LLM (optimiert) ---
OPENAI_API_KEY=***
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT=120
OPENAI_MAX_TOKENS=3200

# --- Anthropic (Executive Summary) ---
USE_ANTHROPIC_FOR_EXEC_SUMMARY=1
ANTHROPIC_API_KEY=***

# --- PDF (optimiert) ---
PDF_SERVICE_URL="https://make-ki-pdfservice-production.up.railway.app"
PDF_TIMEOUT_MS=120000
MAX_HTML_PAYLOAD_KB=350
MAX_PDF_SIZE_MB=20

# --- PDF Alert Thresholds ---
PDF_WARN_SIZE_MB=10
PDF_ALERT_SIZE_MB=18
PDF_BLOCK_SIZE_MB=20
PDF_TIMEOUT_SEC=20

# --- Research (optimiert) ---
RESEARCH_PROVIDER=hybrid
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=10
TAVILY_TIMEOUT_MS=15000
PERPLEXITY_API_KEY=
PERPLEXITY_MAX_TOKENS=2500
PERPLEXITY_TIMEOUT_MS=15000
RESEARCH_CACHE_PATH=data/research_cache.json
RESEARCH_CACHE_TTL=21600

# --- Quality & Features ---
ENABLE_QUALITY_GATES=1
ENABLE_REPAIR_HTML=1
ENABLE_LLM_CACHE=1
MASK_EMAILS=1

# --- Monitoring Thresholds ---
MIN_SECTION_WORDS=50
MAX_FALLBACKS_PER_REPORT=3
GUARDRAIL_HIGH_CONF=0.9
TOKEN_BUDGET_THRESHOLD_PCT=95

# --- Sprint G8.2: Validation & AI Act Config ---
# Size mismatch handling (1=hard stop, 0=warning only)
HARD_STOP_ON_SIZE_MISMATCH=1

# Maximum redundancy warnings per report
VALIDATION_MAX_REDUNDANCY_WARNINGS=5

# Minimum words for redundancy detection
VALIDATION_REDUNDANCY_THRESHOLD=20

# AI Act Compliance Settings
AI_ACT_ENABLED=1
AI_ACT_MIN_REASONING_WORDS=60
AI_ACT_MIN_DUTY_MATRIX_ROWS=3
AI_ACT_MIN_ALERTS=2
AI_ACT_MAX_ALERTS=10
AI_ACT_MIN_GAPS=2
AI_ACT_MAX_GAPS=8
AI_ACT_SECTION_VERBOSE=0
AI_ACT_APPLY_BC_MODIFIERS=1

# Fallback hard stop
HARD_STOP_MAX_FALLBACKS=5

# --- Admin Routes (production: disabled) ---
ENABLE_ADMIN_ROUTES=0
ADMIN_ALLOW_RAW_SQL=0

# =============================================================================
# SPRINT G11: PRODUCT MODE
# =============================================================================

# --- Report Versioning ---
REPORT_VERSIONING_ENABLED=1
PDF_SNAPSHOT_ENABLED=1
MAX_STORED_REPORTS=50
MAX_REPORT_VERSIONS=10

# --- Delta Engine ---
ENABLE_DELTA_ENGINE=1
DELTA_EMBEDDING_MODEL=
DELTA_WORD_THRESHOLD=50
DELTA_SCORE_THRESHOLD=5.0

# --- Business Case Visualizer ---
ENABLE_BC_VISUALS=1

# --- Dashboard API ---
ENABLE_DASHBOARD_API=1

# --- Premium Features ---
# Smart Funding Recommender (default: disabled)
ENABLE_PREMIUM_FUNDING=0
FUNDING_DATA_PATH=data/funding_programmes_core_2025.json

# =============================================================================
# SPRINT G12: RESILIENCE & PRODUCTION SHIELD
# =============================================================================

# --- A) Circuit Breaker (LLM Providers) ---
LLM_CIRCUIT_BREAKER_ENABLED=1
LLM_CIRCUIT_FAILURE_THRESHOLD=5
LLM_CIRCUIT_RESET_SECONDS=60
LLM_CIRCUIT_WINDOW_SECONDS=90
LLM_CIRCUIT_STATE_FILE=/tmp/circuit_breaker_state.json

# --- B) Rate Limiting (Reports) ---
RATE_LIMIT_ENABLED=1
REPORT_RATE_LIMIT_PER_MINUTE=5
REPORT_RATE_LIMIT_GLOBAL=20

# --- C) Degradation Monitor ---
DEGRADATION_MONITORING_ENABLED=1
DEGRADATION_HARD_STOP_THRESHOLD=30
DEGRADATION_WARN_THRESHOLD=60
DEGRADATION_WINDOW_SECONDS=300

# --- D) AI-Act Validator v2 ---
AI_ACT_STRICT_VALIDATION=1
AI_ACT_REQUIRE_FUNDING_IMPACT=1
AI_ACT_FAIL_ON_INCONSISTENCY=0

# --- E) Business Case Reconciler ---
BC_RECONCILE_ENABLED=1
BC_ROUNDING_DECIMALS=1
BC_FAIL_ON_INCONSISTENCY=0

# --- F) PDF Guard ---
PDF_GUARD_ENABLED=1
PDF_MAX_HTML_MB=1.2
PDF_MAX_TABLES=30
PDF_MAX_IMAGES=20
PDF_MAX_LOGOS=5
PDF_FAIL_ON_OVERSIZE=0
PDF_TRUNCATE_ON_OVERSIZE=1
PDF_MAX_RETRIES=3

# =============================================================================
# SPRINT G13: POLISH, RELIABILITY & PRODUCT-FINISH
# =============================================================================

# --- Fallback Optimization ---
FALLBACK_TIMEOUT_SEC=60
FALLBACK_TOKEN_BUDGET=2500
FALLBACK_MIN_WORD_RATIO=0.85

# =============================================================================
# SPRINT G14: STABILITY & RUNTIME HARDENING
# =============================================================================

# --- LLM Retry Layer ---
LLM_SHORT_RETRY_ENABLED=1
LLM_SHORT_RETRY_MAXTOKENS=1200
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_BASE=1.0
LLM_RETRY_BACKOFF_MULTIPLIER=2.0

# --- Research Pipeline Circuit Breaker ---
PPLX_FAILURE_THRESHOLD=2
PPLX_CIRCUIT_RESET_SEC=120
PPLX_TIMEOUT=30
TAVILY_TIMEOUT=8

# =============================================================================
# SPRINT G15: RELEASE R1 / LAUNCH-MODE
# =============================================================================

# --- Environment ---
# Set to "production" for live deployment
ENVIRONMENT=production

# --- Release Health Monitoring ---
# These are used by /api/dashboard/release-health

# --- Feature Flags Summary (R1 Defaults) ---
# AI_ACT_ENABLED=1              # G7: AI Act classification
# REPORT_VERSIONING_ENABLED=1   # G11: Version history
# ENABLE_DASHBOARD_API=1        # G11: Dashboard endpoints
# RATE_LIMIT_ENABLED=1          # G12: Rate limiting
# LLM_CIRCUIT_BREAKER_ENABLED=1 # G12: Circuit breaker
# LLM_SHORT_RETRY_ENABLED=1     # G14: LLM retry
# ENABLE_PREMIUM_FUNDING=0      # G11: Premium (off by default)
# FEEDBACK_LOOP_ENABLED=1       # G16: Real-World Feedback Loop

# =============================================================================
# SPRINT G16: REAL-WORLD FEEDBACK LOOP
# =============================================================================

# --- Feedback Collection ---
FEEDBACK_LOOP_ENABLED=1
FEEDBACK_RETENTION_DAYS=90

# --- Feedback Analysis ---
FEEDBACK_TREND_WINDOW=7
FEEDBACK_ANOMALY_THRESHOLD=5

# =============================================================================
# SPRINT G17: REAL-WORLD INSIGHTS & RECOMMENDATIONS 2.0
# =============================================================================

# --- Insights Engine ---
INSIGHTS_ENGINE_ENABLED=1
INSIGHTS_MIN_REPORTS_PER_SEGMENT=10
INSIGHTS_TOP_CARDS_PER_REPORT=5
INSIGHTS_REFRESH_INTERVAL_MIN=30

# --- Funding Insights ---
FUNDING_INSIGHTS_ENABLED=1
FUNDING_MIN_CASES_PER_PROGRAM=5

# --- Dashboard Insights ---

# =============================================================================
# SPRINT G17.1: SEGMENT CALIBRATION & INSIGHT RELIABILITY
# =============================================================================

# --- G17.1-A: Segment Calibration ---
# Standard deviations beyond which values are winsorized (outlier dampening)
INSIGHTS_SEGMENT_OUTLIER_STD=2.5
# Minimum sample size to include segment (warning threshold)
INSIGHTS_SEGMENT_SAMPLE_WARNING=5
# Minimum standard deviation threshold for confidence scoring
INSIGHTS_MIN_STD_CONFIDENCE=0.15
# Enable confidence level calculations
INSIGHTS_CONFIDENCE_LEVELS_ENABLED=1

# --- G17.1-B: Insight Reliability Filter ---
# Only show insights for reliable segments (stability = strong/medium)
INSIGHTS_REQUIRE_RELIABLE_SEGMENT=1
# Use generic fallback cards when segment is unreliable
INSIGHTS_FALLBACK_TO_GENERIC=1

# --- G17.1-C: Funding Insight Stability ---
# Only show funding insights for stable segments
FUNDING_REQUIRE_STABLE_SEGMENT=1
# Show confidence indicator badges in HTML output
FUNDING_SHOW_CONFIDENCE_INDICATOR=1

# =============================================================================
# SPRINT G17.2: PREDICTIVE INSIGHTS & SMART DEFAULTS
# =============================================================================

# --- G17.2-A: Predictive Engine ---
# Enable predictive analytics based on segment data
PREDICTIVE_ENGINE_ENABLED=1
# Minimum segment stability required for predictions (weak/medium/strong)
PREDICTIVE_MIN_SEGMENT_STABILITY=medium
# Smoothing factor for prediction calculations (0.0-1.0)
PREDICTIVE_SCORE_SMOOTHING=0.2
# Trend analysis window in days
PREDICTIVE_TREND_WINDOW_DAYS=14

# --- G17.2-B: Smart Defaults for Prompt Engine ---
# Enable automatic prompt adjustments based on segment feedback
PROMPT_SMART_DEFAULTS_ENABLED=1
# Factor to increase word count for segments with "too short" warnings
PROMPT_DEFAULT_WORD_INCREASE_FACTOR=1.12

# --- G17.2-C: Funding Predictive Matching ---
# Enable predictive funding opportunity scoring
FUNDING_PREDICTIVE_ENABLED=1
# Weight of trend data in opportunity score calculation (0.0-1.0)
FUNDING_TREND_WEIGHT=0.3
# Minimum confidence level to display funding opportunity (0.0-1.0)
FUNDING_MIN_CONFIDENCE_FOR_DISPLAY=0.5

# --- G17.2-D: Dashboard Predictive Panels ---
# Enable predictive health dashboard panels

# =============================================================================
# SPRINT G17.3: LLM FINE-TUNING SIGNALS
# =============================================================================

# --- G17.3: Fine-Tuning Signal Extraction ---
# Enable extraction of fine-tuning signals from generated reports
FT_SIGNAL_EXTRACTION_ENABLED=1
# Auto-build training dataset after each report generation
FT_BUILD_DATASET_ON_REPORT=0
# Number of days to include in dataset builds (rolling window)
FT_DATASET_DAYS=30
# Minimum confidence threshold for signal inclusion (0.0-1.0)
FT_MIN_CONFIDENCE_THRESHOLD=0.35
# Maximum signals to extract per report
FT_MAX_SIGNALS_PER_REPORT=12
# Strict privacy mode - enables PII anonymization
FT_PRIVACY_STRICT_MODE=1
# Enable debug logging for signal extraction
FT_SIGNAL_DEBUG_LOGGING=0
# Include weak segment signals (0=suppress, 1=allow)
FT_ALLOW_WEAK_SEGMENTS=0

# --- G17.3-Storage ---
# Path for storing fine-tuning signals and datasets
FT_SIGNAL_STORAGE_PATH=data/ft_signals

# =============================================================================
# SPRINT G17.4: AUTO-PROMPT-REWRITE ENGINE
# =============================================================================

# --- G17.4: Prompt Rewrite Engine ---
# Enable automatic prompt weakness detection and rewrite suggestions
PROMPT_REWRITE_ENGINE_ENABLED=1
# Minimum confidence threshold for rewrite suggestions (0.0-1.0)
PROMPT_REWRITE_MIN_CONFIDENCE=0.45
# Require strong segment stability for suggestions (1=require medium+, 0=allow weak)
PROMPT_REWRITE_REQUIRE_STRONG_SEGMENT=1
# Maximum rewrite suggestions to generate per analysis
PROMPT_REWRITE_MAX_SUGGESTIONS=10
# Generate diff-style patches for suggestions
PROMPT_REWRITE_GENERATE_PATCHES=1
# Enable debug logging for prompt rewrite engine
PROMPT_REWRITE_DEBUG=0

# --- G17.4-Storage ---
# Path for storing prompt rewrite suggestions
PROMPT_REWRITE_STORAGE_PATH=data/prompt_rewrites

# =============================================================================
# SPRINT G17.5: AUTO-LEARNING PROMPT TUNER
# =============================================================================

# --- G17.5: Core Settings ---
# Enable the auto-learning prompt tuner
PROMPT_TUNER_ENABLED=1
# Dry-run mode: calculate tuning but don't apply changes
PROMPT_TUNER_DRY_RUN=0

# --- G17.5: Minimum Requirements ---
# Minimum samples required before tuning a segment
TUNER_MIN_SAMPLES=20
# Minimum segment stability for tuning (weak|medium|strong)
TUNER_MIN_SEGMENT_STABILITY=medium

# --- G17.5: Word Factor Limits ---
# Maximum multiplier for target word length
TUNER_MAX_WORD_FACTOR=1.30
# Minimum multiplier for target word length
TUNER_MIN_WORD_FACTOR=0.90

# --- G17.5: Emphasis Weight Limits ---
# Maximum delta per iteration for emphasis weights (+/- 25%)
TUNER_MAX_EMPHASIS_DELTA=0.25

# --- G17.5: Redundancy Sensitivity Limits ---
TUNER_MAX_REDUNDANCY_SENSITIVITY=1.5
TUNER_MIN_REDUNDANCY_SENSITIVITY=0.5

# --- G17.5: Persona Strictness Limits ---
# Persona strictness can only increase, never decrease below base
TUNER_PERSONA_STRICTNESS_MIN=1.0
TUNER_PERSONA_STRICTNESS_MAX=1.5

# --- G17.5: Update Interval ---
# Minimum seconds between profile updates
TUNER_UPDATE_INTERVAL_MIN=60

# --- G17.5: Debugging ---
TUNER_LOG_DEBUG=0

# --- G17.5: Storage ---
TUNER_STORAGE_PATH=data/prompt_tuner

# =============================================================================
# SPRINT G17.6: PROMPT GOVERNANCE & DRIFT CONTROL
# =============================================================================

# --- G17.6: Core Settings ---
# Enable prompt governance layer
PROMPT_GOVERNANCE_ENABLED=1
# Draft mode: calculate but don't persist changes
PROMPT_DRAFT_MODE=0

# --- G17.6: Drift Thresholds ---
# Score thresholds for drift categorization (0-100)
PROMPT_DRIFT_THRESHOLD_LOW=15
PROMPT_DRIFT_THRESHOLD_MEDIUM=30
PROMPT_DRIFT_THRESHOLD_HIGH=50
PROMPT_DRIFT_THRESHOLD_CRITICAL=70

# --- G17.6: Simulation Settings ---
# Number of profiles to test in simulation
PROMPT_SIMULATION_PROFILE_COUNT=10
# Minimum improvements required to pass
PROMPT_SIMULATION_REQUIRED_IMPROVEMENTS=1
# Number of regressions that trigger hard stop
PROMPT_SIMULATION_HARD_STOP_REGRESSIONS=2

# --- G17.6: Patch Approval Settings ---
# Enable auto-approval for low/medium drift
PROMPT_PATCH_AUTO_APPROVE=1
# Require manual approval for high drift
PROMPT_PATCH_REQUIRE_MANUAL_APPROVAL_FOR_HIGH_DRIFT=1
# Logging level for patch decisions (info|debug)
PROMPT_PATCH_LOG_LEVEL=info

# --- G17.6: Storage Paths ---
PROMPT_SNAPSHOTS_PATH=data/prompt_snapshots
DRIFT_RESULTS_PATH=data/drift_results
PATCH_DECISIONS_PATH=data/patch_decisions
SIMULATION_RESULTS_PATH=data/simulation_results

# =============================================================================
# SPRINT G17.7: PROMPT STABILITY SCORING & AUTO-FREEZE MECHANISM
# =============================================================================

# --- G17.7: Stability Scoring Settings ---
# Enable stability scoring engine
STABILITY_SCORING_ENABLED=1

# --- G17.7: Auto-Freeze Settings ---
# Enable auto-freeze mechanism
AUTO_FREEZE_ENABLED=1
# Freeze trigger thresholds
FREEZE_STABILITY_THRESHOLD=20
FREEZE_CONSECUTIVE_HIGH_DRIFT=2
FREEZE_SIMULATION_REGRESSION_CATEGORIES=3
FREEZE_AI_ACT_SEVERITY_THRESHOLD=major

# --- G17.7: Auto-Recovery Settings ---
# Enable auto-recovery
AUTO_RECOVERY_ENABLED=1
# Minimum stability score for recovery candidate
RECOVERY_MIN_STABILITY_SCORE=50
# Maximum versions to check for recovery
RECOVERY_MAX_ROLLBACK_VERSIONS=5
# Require manual approval for recovery
RECOVERY_REQUIRE_APPROVAL=0

# --- G17.7: Lifecycle Management Settings ---
# Enable lifecycle state machine
LIFECYCLE_ENABLED=1
# Log all state transitions
LIFECYCLE_LOG_TRANSITIONS=1
# Maximum history entries to keep per prompt
LIFECYCLE_MAX_HISTORY=100

# --- G17.7: Storage Paths ---
FREEZE_STORAGE_PATH=data/prompt_freeze
RECOVERY_STORAGE_PATH=data/prompt_recovery
LIFECYCLE_STORAGE_PATH=data/prompt_lifecycle

# =============================================================================
# SPRINT G17.8: FUNDING AUTO-OPTIMIZER & INTELLIGENT REBALANCING
# =============================================================================

# --- G17.8-A: Funding Distribution Analyzer ---
# Enable distribution analysis
FUNDING_DISTRIBUTION_ENABLED=1
# Threshold for overrepresentation (1.5 = 50% over expected)
FUNDING_OVERREP_THRESHOLD=1.5
# Threshold for underrepresentation (0.5 = 50% under expected)
FUNDING_UNDERREP_THRESHOLD=0.5
# Minimum samples needed for rebalancing recommendations
FUNDING_DISTRIBUTION_MIN_SAMPLES=10
# Delta threshold for triggering rebalancing (0.15 = 15%)
FUNDING_REBALANCING_THRESHOLD=0.15
# Storage path for distribution snapshots
FUNDING_DISTRIBUTION_STORAGE_PATH=data/funding_distribution

# --- G17.8-B: Funding Confidence Rebalancer ---
# Enable confidence rebalancing layer
CONFIDENCE_REBALANCING_ENABLED=1
# Maximum adjustment allowed (+/- 30%)
CONFIDENCE_MAX_ADJUSTMENT=0.3
CONFIDENCE_MIN_ADJUSTMENT=-0.3
# Decay rate for returning to baseline (10% per cycle)
CONFIDENCE_DECAY_RATE=0.1
# Boost rate for positive ROI (15%)
CONFIDENCE_BOOST_RATE=0.15
# Smoothing factor for exponential moving average
CONFIDENCE_SMOOTHING_FACTOR=0.7
# Storage path for rebalancing data
CONFIDENCE_REBALANCING_STORAGE_PATH=data/funding_rebalancing

# --- G17.8-C: ROI Impact Analyzer ---
# Enable ROI tracking and predictive boost
ROI_TRACKING_ENABLED=1
# Maximum predictive boost factor
ROI_PREDICTIVE_BOOST_MAX=1.3
# Minimum predictive boost factor (penalty)
ROI_PREDICTIVE_BOOST_MIN=0.7
# Minimum samples required for reliable boost
ROI_MIN_SAMPLES_FOR_BOOST=5

# --- G17.8-D: Funding Auto-Optimizer Engine ---
# Enable auto-optimizer engine
FUNDING_OPTIMIZER_ENABLED=1
# Optimization cycle interval in hours
FUNDING_OPTIMIZER_CYCLE_HOURS=24
# Minimum recommendations needed to run optimization
FUNDING_OPTIMIZER_MIN_RECOMMENDATIONS=20
# Enable automatic application of proposals
FUNDING_OPTIMIZER_AUTO_APPLY=0
# Run in dry-run mode (calculate but don't apply)
FUNDING_OPTIMIZER_DRY_RUN=1
# Storage path for optimization runs
FUNDING_OPTIMIZER_STORAGE_PATH=data/funding_optimizer

# --- G17.8-E: Funding Patch Gate (Governance) ---
# Enable patch gate for governance
FUNDING_PATCH_GATE_ENABLED=1
# Enable automatic approval for high-confidence patches
FUNDING_PATCH_AUTO_APPROVE=0
# Maximum change percentage allowed per patch
FUNDING_PATCH_MAX_CHANGE_PCT=30.0
# Minimum confidence required for proposals
FUNDING_PATCH_MIN_CONFIDENCE=0.6
# Require manual review for all patches
FUNDING_PATCH_REQUIRE_REVIEW=1
# Hours within which rollback is allowed
FUNDING_PATCH_ROLLBACK_WINDOW_HOURS=72
# Storage path for patches
FUNDING_PATCH_GATE_STORAGE_PATH=data/funding_patches

# =============================================================================
# SPRINT B2: TOOLS ENGINE 2.0 - Real-World Adoption & Predictive Intelligence
# =============================================================================

# --- B2-A: Tools Analytics Layer ---
# Enable the tools engine
TOOLS_ENGINE_ENABLED=1
# Minimum confidence threshold for recommendations
TOOLS_CONFIDENCE_MIN=0.35
# Show confidence badges in HTML output
TOOLS_CONFIDENCE_SHOW_BADGES=1
# Standard deviations for outlier trimming (Winsorizing)
TOOLS_SEGMENT_OUTLIER_STD=2.5
# Minimum sample size for reliable segments
TOOLS_MIN_SAMPLE_SIZE=5
# Storage path for tools analytics
TOOLS_ANALYTICS_STORAGE_PATH=data/tools_analytics

# --- B2-B: Tools Recommendation Engine 2.0 ---
# Enable predictive trend engine
TOOLS_PREDICTIVE_ENABLED=1
# Trend window in days for analysis
TOOLS_PREDICTIVE_TREND_WINDOW=30
# Weight of trend data in final score calculation (0.0-1.0)
TOOLS_TREND_WEIGHT=0.3
# Enable generic fallback when segment data is weak
TOOLS_GENERIC_FALLBACK_ENABLED=1
# Require reliable segment for recommendations
TOOLS_REQUIRE_RELIABLE_SEGMENT=1
# Enable smart defaults based on persona
TOOLS_SMART_DEFAULTS_ENABLED=1
# Maximum tool recommendations per report
TOOLS_MAX_RECOMMENDATIONS=12
# Storage path for trend data
TOOLS_TREND_STORAGE_PATH=data/tools_trends

# --- B2-D: Tools Drift Detection & Governance ---
# Enable tools drift detection
TOOLS_DRIFT_ENABLED=1
# Drift score thresholds
TOOLS_DRIFT_THRESHOLD_LOW=15
TOOLS_DRIFT_THRESHOLD_MEDIUM=30
TOOLS_DRIFT_THRESHOLD_HIGH=50
TOOLS_DRIFT_THRESHOLD_CRITICAL=75
# Auto-freeze thresholds
TOOLS_FREEZE_CONFIDENCE_THRESHOLD=0.20
TOOLS_FREEZE_SEGMENT_COUNT=2
# Maximum tools before overpopulation warning
TOOLS_OVERPOPULATION_LIMIT=14
# Storage path for drift data
TOOLS_DRIFT_STORAGE_PATH=data/tools_drift

# --- B2-E: Tools Dashboard ---
# Enable tools dashboard endpoints
DASHBOARD_TOOLS_ENABLED=1

# =============================================================================
# SPRINT B2.2: TOOLS × FUNDING ALIGNMENT (Premium Integration)
# =============================================================================

# --- B2.2-A: Tools-Funding Alignment Engine ---
# Enable tool-funding alignment matching
TOOLS_FUNDING_ALIGNMENT_ENABLED=1
# Minimum alignment score to include a match (0.0-1.0)
ALIGNMENT_MIN_SCORE=0.35
# Maximum alignment recommendations per report
ALIGNMENT_MAX_RECOMMENDATIONS=8
# Alignment scoring weights (must sum to 1.0)
ALIGNMENT_WEIGHT_CATEGORY=0.30
ALIGNMENT_WEIGHT_SIZE=0.25
ALIGNMENT_WEIGHT_BRANCH=0.20
ALIGNMENT_WEIGHT_KI_RELEVANCE=0.15
ALIGNMENT_WEIGHT_COMPLEXITY=0.10

# --- B2.2-B: Starter-Kit Generator ---
# Enable starter kit generation
STARTER_KITS_ENABLED=1
# Maximum tools per starter kit
STARTER_KIT_MAX_TOOLS=5
# Maximum funding programs per starter kit
STARTER_KIT_MAX_FUNDING=3

# =============================================================================
# P1: AUTOMATION PIPELINE (Report Generation via Fixtures)
# =============================================================================
# These variables configure the automation/CI pipeline for generating
# reference reports from JSON fixtures.
#
# See docs/AUTOMATION.md for detailed usage instructions.
# See scripts/submit_fixture.py --help for CLI options.
# =============================================================================

# --- API Base URL (Fallback Chain) ---
# Priority: CLI --base-url > API_BASE_URL > BACKEND_BASE > SMOKE_BASE_URL > default
#
# For local development:
# API_BASE_URL=http://localhost:8000
#
# For Railway production (BACKEND_BASE is already set in Railway ENV):
# BACKEND_BASE=https://api-ki-backend-neu-production.up.railway.app

# --- Service Token (Fallback Chain) ---
# Priority: CLI --service-token > SERVICE_TOKEN > SMOKE_AUTH_TOKEN
#
# SERVICE_TOKEN=your-service-token-here
# SMOKE_AUTH_TOKEN is already set in Railway ENV for smoke tests

# --- Polling Configuration ---
# How often to check briefing status (seconds)
POLL_INTERVAL=2
# Maximum time to wait for report completion (seconds)
POLL_TIMEOUT=300

# --- Quality Gates ---
# Enable strict leak gate (fail solo reports with Team/KMU language)
LEAK_GATE_STRICT=0
# Enable release strict mode (zero tolerance for quality issues)
RELEASE_STRICT_MODE=0

# --- Admin & Cron Secrets (REQUIRED for admin/cron endpoints) ---
# Gates all /api/admin/* and /api/strategy admin endpoints (feedback list, exports).
# Compared in constant time (hmac.compare_digest). Leave unset to disable admin access.
STRATEGY_ADMIN_KEY=
# Gates POST /api/content/research-news (triggers paid Tavily+OpenAI research runs).
# Compared in constant time. Leave unset to disable the cron endpoint entirely.
CRON_SECRET=

# --- AI Model IDs (all configurable; change here, no code deploy needed) ---
# OpenAI (news summarizer, analysis, exec summary, ...). gpt-4o is EOL-track; migrate via ENV.
OPENAI_MODEL=gpt-4o
OPENAI_MODEL_FAST=gpt-4o
OPENAI_MODEL_REASONING=gpt-4o
OPENAI_MODEL_FALLBACK=gpt-4o-mini
# Anthropic (chat, coach, appetizer). Current-gen IDs as of 2026-07.
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Medien-Vertikale (KIS-1288) ---------------------------------------------
# In Produktion (Railway, Shared Variables) sind beide gesetzt. Ohne sie zeigt
# der Fragebogen alle 13 Branchen und die Reports laufen mit der KMU-Persona.
# VISIBLE_BRANCHES=medien
# REPORT_PERSONA_PATH=prompts/de/_persona_medien.md
ANTHROPIC_MODEL_OPUS=claude-opus-4-8
ANTHROPIC_MODEL_FALLBACK=claude-sonnet-4-6
CHAT_EXTRACTOR_MODEL=claude-haiku-4-5-20251001
CHAT_CONVERSATION_MODEL=claude-sonnet-4-6
ANTHROPIC_MODEL_APPETIZER=claude-sonnet-4-6
# Perplexity research
PERPLEXITY_MODEL=sonar-pro

# --- PDF Service ---
# Shared secret sent to make-ki-pdfservice as X-PDF-Secret. Must match the
# PDF_SHARED_SECRET configured on the PDF service. Leave empty to disable auth.
PDF_SHARED_SECRET=
